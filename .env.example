# ═══════════════════════════════════════════════════════════════════
#  TrustCare India — Environment Configuration
#  Copy this file to .env and fill in your values.
#  At minimum set one of: GEMINI_API_KEY, OPENAI_API_KEY, or
#  DATABRICKS_HOST + DATABRICKS_TOKEN.
# ═══════════════════════════════════════════════════════════════════

# ── LLM Provider ──────────────────────────────────────────────────
# Auto-priority: databricks → gemini → openai → local
# Override: LLM_PROVIDER=gemini | openai | databricks | local
# LLM_PROVIDER=gemini

# ── Google Gemini (primary — free tier available) ──────────────────
GEMINI_API_KEY=paste-your-google-ai-studio-key-here
GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001

# ── OpenAI (optional alternative) ────────────────────────────────
# OPENAI_API_KEY=sk-...
# CHAT_MODEL=gpt-4o
# EMBED_MODEL=text-embedding-3-small

# ── Databricks (hackathon primary stack) ──────────────────────────
# Workspace settings → Developer → Personal Access Tokens
# DATABRICKS_HOST=https://your-workspace.azuredatabricks.net
# DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXX

# SQL Warehouse (Databricks UI → SQL → Warehouses → copy ID)
# DATABRICKS_WAREHOUSE_ID=xxxxxxxxxxxxxxxx

# Unity Catalog — facility table
# DATABRICKS_CATALOG=hive_metastore
# DATABRICKS_SCHEMA=healthcare
# DATABRICKS_TABLE=facilities

# Mosaic AI Vector Search (production FAISS replacement)
# DATABRICKS_VECTOR_SEARCH_ENDPOINT=trustcare-vs-endpoint
# DATABRICKS_VECTOR_SEARCH_INDEX=hive_metastore.healthcare.facilities_index

# Foundation Model API (pay-per-token on Free Edition)
# DATABRICKS_FM_ENDPOINT=databricks-meta-llama-3-3-70b-instruct
# DATABRICKS_EMBED_ENDPOINT=databricks-bge-large-en

# ── Dataset Source ────────────────────────────────────────────────
# local_excel (default) | databricks_export
DATA_SOURCE=local_excel
# DATASET_PATH=VF_Hackathon_Dataset_India_Large.xlsx
# DATABRICKS_EXPORT_PATH=databricks_facility_export.parquet

# ── Web Search (free key at https://app.tavily.com) ───────────────
# TAVILY_API_KEY=tvly-...

# ── MLflow Observability ──────────────────────────────────────────
MLFLOW_ENABLED=true
MLFLOW_EXPERIMENT=serving-a-nation
# Use Databricks as tracking server (requires DATABRICKS_HOST + TOKEN):
# MLFLOW_TRACKING_URI=databricks
# Or local: MLFLOW_TRACKING_URI=file:./mlruns
