# Copy this file to ".env" in the SAME folder as main.py, then fill in your key.
# Windows path example: C:\Users\DELL\OneDrive\Desktop\MIT Hackathon Implementation\.env

# --- Gemini (Google AI Studio) — use ONE of these variable names ---
GEMINI_API_KEY=paste-your-key-here
# GOOGLE_API_KEY=paste-your-key-here

# Chat model (plain id only — do NOT paste Python code here)
# GEMINI_CHAT_MODEL=gemini-2.0-flash
# (GEMINI_MODEL is also read as an alias for GEMINI_CHAT_MODEL)
# GEMINI_EMBED_MODEL=gemini-embedding-001

# Optional: web snippets on queries (uses credits)
# TAVILY_API_KEY=

# Optional: force provider if you have multiple keys set
# LLM_PROVIDER=gemini

# --- Data source adapter ---
# local_excel (default): reads DATASET_PATH Excel file
# databricks_export: reads DATABRICKS_EXPORT_PATH (parquet/csv/json/xlsx)
# DATA_SOURCE=local_excel
# DATASET_PATH=VF_Hackathon_Dataset_India_Large.xlsx
# DATABRICKS_EXPORT_PATH=databricks_facility_export.parquet

# Optional MLflow
# MLFLOW_TRACKING_URI=file:./mlruns
# MLFLOW_EXPERIMENT=serving-a-nation
